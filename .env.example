# ==============================================================================
# TUMA PLATFORM - CONFIGURATION LOCALE DE DÉVELOPPEMENT
# ==============================================================================

# Port du serveur API NestJS
PORT=3000
NODE_ENV=development

# Connexion MongoDB
MONGO_URI=mongodb://localhost:27017/tuma_db

# Connexion Redis (Cache & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Transport SMTP Local (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# Clé secrète maître pour le chiffrement des tokens internes et clés privées
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# URLs de tracking
TRACKING_BASE_URL=http://localhost:3000/v1/track
