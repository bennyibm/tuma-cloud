{
  "name": "tuma-cloud-monorepo",
  "version": "1.0.0",
  "description": "TUMA Cloud — The Lightning-Fast Transactional Email Infrastructure for Africa and the World",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:all": "npm run build --prefix apps/api && npm run build --prefix apps/dashboard && npm run build --prefix apps/web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed": "cd apps/api && node dist/main.js",
    "test": "node scripts/check-secrets.mjs",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "email",
    "transactional-email",
    "fintech",
    "dkim",
    "africa",
    "telecom",
    "resend",
    "sendgrid"
  ],
  "author": "TUMA Cloud Inc.",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0"
  }
}
