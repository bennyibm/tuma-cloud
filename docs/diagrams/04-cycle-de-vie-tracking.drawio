<mxfile host="app.diagrams.net" modified="2026-08-27T10:15:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="diag_lifecycle" name="Cycle de Vie et Rebonds">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITRE -->
        <mxCell id="title_life" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;🔄 Machine à États : Cycle de Vie, Tracking &amp;amp; Gestion des Rebonds (Bounces)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="740" height="40" as="geometry" />
        </mxCell>

        <!-- STATUT 1: QUEUED -->
        <mxCell id="st_queued" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1. QUEUED&lt;/b&gt;&lt;hr&gt;Reçu par l'API&lt;br&gt;Validé &amp;amp; Déposé dans Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- STATUT 2: SENDING -->
        <mxCell id="st_sending" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2. SENDING&lt;/b&gt;&lt;hr&gt;Pris en charge par le Worker&lt;br&gt;Rendu Handlebars + Pixel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;fontColor=#6B21A8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- STATUT 3: SENT -->
        <mxCell id="st_sent" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;3. SENT&lt;/b&gt;&lt;hr&gt;Accepté par le Relais SMTP/SES&lt;br&gt;Message-ID attribué" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- STATUT 4: DELIVERED -->
        <mxCell id="st_delivered" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;4. DELIVERED&lt;/b&gt;&lt;hr&gt;Remis au serveur distant&lt;br&gt;(Gmail, Outlook, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- STATUT 5: OPENED -->
        <mxCell id="st_opened" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;5. OPENED 👁️&lt;/b&gt;&lt;hr&gt;Pixel 1x1 chargé par l'utilisateur&lt;br&gt;IP &amp;amp; User-Agent consignés" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="380" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- STATUT 6: CLICKED -->
        <mxCell id="st_clicked" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;6. CLICKED 🔗&lt;/b&gt;&lt;hr&gt;Lien réécrit cliqué&lt;br&gt;Redirection 302 instantanée" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#451A03;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ERREUR 1: SOFT BOUNCE -->
        <mxCell id="st_soft" value="&lt;b style=&quot;font-size: 13px; color:#D97706;&quot;&gt;⚠️ SOFT BOUNCE&lt;/b&gt;&lt;hr&gt;Boîte pleine / 421 Surchargé&lt;br&gt;&lt;i&gt;Retentative automatique (3x)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#92400E;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ERREUR 2: HARD BOUNCE -->
        <mxCell id="st_hard" value="&lt;b style=&quot;font-size: 13px; color:#DC2626;&quot;&gt;❌ HARD BOUNCE&lt;/b&gt;&lt;hr&gt;550 User Unknown / Invalide&lt;br&gt;Échec permanent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ERREUR 3: PLAINTE SPAM -->
        <mxCell id="st_complaint" value="&lt;b style=&quot;font-size: 13px; color:#B91C1C;&quot;&gt;🚨 PLAINTE SPAM (FBL)&lt;/b&gt;&lt;hr&gt;Le destinataire a cliqué&lt;br&gt;&quot;Signaler comme spam&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;fontColor=#881337;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ACTION AUTOMATIQUE: SUPPRESSION LIST -->
        <mxCell id="box_auto_supp" value="&lt;b style=&quot;font-size: 15px; color:#FFFFFF;&quot;&gt;🛡️ AUTO-SUPPRESSION (LISTE NOIRE)&lt;/b&gt;&lt;hr&gt;&lt;p style=&quot;color:#FFFFFF; margin:0px;&quot;&gt;L'adresse email est immédiatement insérée dans la collection &lt;b&gt;SUPPRESSIONS&lt;/b&gt;.&lt;br&gt;Tous les futurs envois vers cette adresse sont &lt;b&gt;bloqués dès l'API Gateway&lt;/b&gt;.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="620" height="90" as="geometry" />
        </mxCell>

        <!-- TRANSITIONS -->
        <mxCell id="t1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" parent="1" source="st_queued" target="st_sending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="st_sending" target="st_sent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="st_sent" target="st_delivered">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="st_delivered" target="st_opened">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=2;" edge="1" parent="1" source="st_opened" target="st_clicked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_soft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;" edge="1" parent="1" source="st_sending" target="st_soft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_soft_retry" value="Retry (Backoff)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;dashed=1;" edge="1" parent="1" source="st_soft" target="st_sending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="200" />
              <mxPoint x="400" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t_hard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EF4444;strokeWidth=2;" edge="1" parent="1" source="st_sent" target="st_hard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_comp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E11D48;strokeWidth=2;" edge="1" parent="1" source="st_delivered" target="st_complaint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t_supp1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EF4444;strokeWidth=2;" edge="1" parent="1" source="st_hard" target="box_auto_supp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="490" />
              <mxPoint x="750" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t_supp2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E11D48;strokeWidth=2;" edge="1" parent="1" source="st_complaint" target="box_auto_supp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
