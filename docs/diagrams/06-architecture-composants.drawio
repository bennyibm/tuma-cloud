        <mxCell id="cmp_sdk_browser" value="&lt;b&gt;📦 @platform/sdk-browser&lt;/b&gt;&lt;br&gt;Fetch API / Captcha Hook&lt;br&gt;&lt;i&gt;sendForm({ publicKey, ... })&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_clients_layer">
