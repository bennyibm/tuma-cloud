        </mxCell>

        <!-- ZONE 2 : BACKEND CORE NESTJS -->
        <mxCell id="box_backend_layer" value="&lt;b&gt;2. Application Backend Modulaire (NestJS Framework)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;fontColor=#0F172A;rounded=1;shadow=1;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="1240" height="510" as="geometry" />
        </mxCell>

        <!-- MODULE 1: AUTH -->
        <mxCell id="mod_auth" value="&lt;b&gt;AuthModule&lt;/b&gt;&lt;hr&gt;• ApiKeyGuard (sk/pk)&lt;br&gt;• OriginCorsGuard&lt;br&gt;• RateLimitInterceptor&lt;br&gt;• Argon2Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="30" y="45" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- MODULE 2: DOMAINS -->
        <mxCell id="mod_domains" value="&lt;b&gt;DomainsModule&lt;/b&gt;&lt;hr&gt;• DomainsController&lt;br&gt;• DnsResolverService&lt;br&gt;• DkimGenerator (RSA)&lt;br&gt;• DomainRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="270" y="45" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- MODULE 3: TEMPLATES -->
        <mxCell id="mod_templates" value="&lt;b&gt;TemplatesModule&lt;/b&gt;&lt;hr&gt;• TemplatesController&lt;br&gt;• HandlebarsService&lt;br&gt;• SchemaValidator&lt;br&gt;• HtmlInlinerService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="510" y="45" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- MODULE 4: SUPPRESSIONS -->
        <mxCell id="mod_suppressions" value="&lt;b&gt;SuppressionsModule&lt;/b&gt;&lt;hr&gt;• SuppressionGuard&lt;br&gt;• BounceHandlerService&lt;br&gt;• FblComplaintListener&lt;br&gt;• SuppressionRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="750" y="45" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- MODULE 5: EMAILS (INGESTION) -->
        <mxCell id="mod_emails" value="&lt;b&gt;EmailsModule&lt;/b&gt;&lt;hr&gt;• EmailsController&lt;br&gt;• IdempotencyService&lt;br&gt;• EmailQueueProducer&lt;br&gt;• EmailRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#92400E;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="990" y="45" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- MODULE 6: TRACKING ENGINE -->
        <mxCell id="mod_tracking" value="&lt;b&gt;TrackingModule&lt;/b&gt;&lt;hr&gt;• PixelController (GET /open/:id)&lt;br&gt;• ClickProxyController (GET /click/:id)&lt;br&gt;• BotDetectorService (Antivirus)&lt;br&gt;• EventLogRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="30" y="195" width="270" height="130" as="geometry" />
        </mxCell>

        <!-- MODULE 7: BULLMQ QUEUES WORKERS -->
        <mxCell id="mod_queues" value="&lt;b&gt;QueuesModule (BullMQ Workers)&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;EmailSendProcessor&lt;/b&gt; (Compilation + Envoi)&lt;br&gt;• &lt;b&gt;TrackingProcessor&lt;/b&gt; (Audit + Compteurs)&lt;br&gt;• &lt;b&gt;WebhookProcessor&lt;/b&gt; (Appels HTTP sortants)&lt;br&gt;• &lt;b&gt;DeadLetterService&lt;/b&gt; (Erreurs irrécupérables)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="340" y="195" width="340" height="130" as="geometry" />
        </mxCell>

        <!-- MODULE 8: WEBHOOKS DISPATCHER -->
        <mxCell id="mod_webhooks" value="&lt;b&gt;WebhooksModule&lt;/b&gt;&lt;hr&gt;• WebhookService (HMAC SHA256)&lt;br&gt;• HttpRetryClient (Axios / Backoff)&lt;br&gt;• DeliveryLogRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="720" y="195" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- MODULE 9: TRANSPORTERS LAYER -->
        <mxCell id="mod_transporters" value="&lt;b&gt;TransportersModule&lt;/b&gt;&lt;hr&gt;• &lt;i&gt;ITransporterAdapter&lt;/i&gt; (Interface)&lt;br&gt;• MailpitMockAdapter (Local Dev)&lt;br&gt;• AwsSesAdapter (@aws-sdk)&lt;br&gt;• SmtpRelayAdapter (Nodemailer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#134E4A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="990" y="195" width="210" height="130" as="geometry" />
        </mxCell>

        <!-- SOUS-ZONE : COUCHE DE PERSISTANCE ET CLIENTS -->
        <mxCell id="sub_infra_layer" value="&lt;b&gt;Couche d'Accès aux Données &amp;amp; Drivers de Connexion&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;rounded=1;startSize=24;" vertex="1" parent="box_backend_layer">
          <mxGeometry x="30" y="355" width="1170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="drv_mongoose" value="&lt;b&gt;🍃 Mongoose ODM Connection Pool&lt;/b&gt;&lt;br&gt;Schemas: OrgSchema, ApiKeySchema, DomainSchema,&lt;br&gt;TemplateSchema, EmailSchema, EventSchema, SuppressionSchema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=11;" vertex="1" parent="sub_infra_layer">
