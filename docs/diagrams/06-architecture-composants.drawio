        <mxCell id="cmp_dashboard_ui" value="&lt;b&gt;💻 React Dashboard SPA&lt;/b&gt;&lt;br&gt;Vite + Tailwind CSS + Lucide&lt;br&gt;TanStack Query + React Router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_clients_layer">
          <mxGeometry x="640" y="38" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cmp_client_webhooks" value="&lt;b&gt;🌐 Serveurs Clients (Endpoints)&lt;/b&gt;&lt;br&gt;Express, Next.js, Django, FastAPI&lt;br&gt;&lt;i&gt;Reçoivent les Webhooks POST&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_clients_layer">
