  <diagram id="diag_component_arch" name="Architecture des Composants">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1000" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITRE -->
        <mxCell id="title_comp" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;🏗️ Architecture des Composants Logiciels (NestJS Core &amp;amp; Frontend)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="650" height="40" as="geometry" />
        </mxCell>

        <!-- ZONE 1 : SDKS & DASHBOARD -->
