        </mxCell>
        <mxCell id="cmp_sdk_node" value="&lt;b&gt;📦 @platform/sdk-node&lt;/b&gt;&lt;br&gt;TypeScript / Axios / Retries&lt;br&gt;&lt;i&gt;emails.send({ ... })&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_clients_layer">
