        <!-- TITRE -->
        <mxCell id="title_db" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;🗄️ Modèle de Données MongoDB (Diagramme Entité-Relation)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- TABLE: ORGANIZATIONS -->
        <mxCell id="tbl_orgs" value="&lt;b&gt;ORGANIZATIONS&lt;/b&gt;&lt;hr&gt;&lt;p align=&quot;left&quot; style=&quot;margin:0px;padding:4px;&quot;&gt;&lt;b&gt;🔑 _id&lt;/b&gt; : ObjectId (PK)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; name : String&lt;br&gt;&lt;b&gt;•&lt;/b&gt; slug : String (Unique)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; plan : String (free|pro|scale)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; monthlyQuota : Number&lt;br&gt;&lt;b&gt;•&lt;/b&gt; usageCount : Number&lt;br&gt;&lt;b&gt;•&lt;/b&gt; settings : Object (tracking)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; createdAt : Date&lt;/p&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="260" height="170" as="geometry" />
        </mxCell>

        <!-- TABLE: API_KEYS -->
        <mxCell id="tbl_keys" value="&lt;b&gt;API_KEYS&lt;/b&gt;&lt;hr&gt;&lt;p align=&quot;left&quot; style=&quot;margin:0px;padding:4px;&quot;&gt;&lt;b&gt;🔑 _id&lt;/b&gt; : ObjectId (PK)&lt;br&gt;&lt;b&gt;🔗 organizationId&lt;/b&gt; : ObjectId (FK)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; type : String (secret | public)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; prefix : String (sk_... | pk_...)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; keyHash : String (Argon2)&lt;br&gt;&lt;b&gt;•&lt;/b&gt; allowedOrigins : Array [String]&lt;br&gt;&lt;b&gt;•&lt;/b&gt; scopes : Array [String]&lt;br&gt;&lt;b&gt;•&lt;/b&gt; isActive : Boolean&lt;br&gt;&lt;b&gt;•&lt;/b&gt; lastUsedAt : Date&lt;/p&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="320" width="260" height="190" as="geometry" />
