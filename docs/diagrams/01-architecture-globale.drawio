  <diagram id="diag_arch_globale" name="Architecture Globale">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITRE -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;📬 Architecture Globale du Système d'Emails (Style Resend / EmailJS)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- ZONE 1 : CLIENTS / DÉVELOPPEURS -->
        <mxCell id="box_clients" value="&lt;b&gt;Clients &amp;amp; Développeurs&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;rounded=1;shadow=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="1040" height="110" as="geometry" />
        </mxCell>

        <mxCell id="client_backend" value="&lt;b&gt;Backend Application&lt;/b&gt;&lt;br&gt;SDK Node / API REST&lt;br&gt;&lt;i&gt;Clé Secrète (sk_live_...)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;" vertex="1" parent="box_clients">
          <mxGeometry x="40" y="40" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="client_frontend" value="&lt;b&gt;Navigateur / Mobile&lt;/b&gt;&lt;br&gt;Client SDK / Formulaires&lt;br&gt;&lt;i&gt;Clé Publique (pk_live_...)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;" vertex="1" parent="box_clients">
          <mxGeometry x="400" y="40" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="client_dashboard" value="&lt;b&gt;Dashboard Admin (React)&lt;/b&gt;&lt;br&gt;Logs Live, Domaines, Clés&lt;br&gt;&lt;i&gt;JWT / Session Utilisateur&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;" vertex="1" parent="box_clients">
          <mxGeometry x="760" y="40" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- ZONE 2 : API CORE (NESTJS) -->
        <mxCell id="box_api" value="&lt;b&gt;API Core (NestJS) — Latence d&#39;ingestion &amp;lt; 30ms&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;fontColor=#065F46;rounded=1;shadow=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="1040" height="130" as="geometry" />
        </mxCell>

        <mxCell id="api_auth" value="&lt;b&gt;1. Auth &amp;amp; Sécurité&lt;/b&gt;&lt;br&gt;Hash validation (Argon2)&lt;br&gt;CORS Origin Whitelist&lt;br&gt;Rate Limiting (Token Bucket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_api">
          <mxGeometry x="40" y="45" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="api_val" value="&lt;b&gt;2. Validation &amp;amp; Idempotence&lt;/b&gt;&lt;br&gt;Schémas Zod / DTOs&lt;br&gt;Contrôle Idempotency-Key&lt;br&gt;Validation des variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_api">
          <mxGeometry x="295" y="45" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="api_guard" value="&lt;b&gt;3. Garde de Suppression&lt;/b&gt;&lt;br&gt;Vérification O(1) Liste Noire&lt;br&gt;Rejet préventif immédiat&lt;br&gt;Protection réputation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_api">
          <mxGeometry x="550" y="45" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="api_dispatcher" value="&lt;b&gt;4. Réponse &amp;amp; Dispatch&lt;/b&gt;&lt;br&gt;Retour 202 Accepted&lt;br&gt;Push Asynchrone dans Redis&lt;br&gt;Persistance Mongo (queued)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_api">
          <mxGeometry x="800" y="45" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- ZONE 3 : STOCKAGE & FILES (MONGODB & REDIS) -->
        <mxCell id="box_data" value="&lt;b&gt;Couche Données &amp;amp; Files Asynchrones&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#92400E;rounded=1;shadow=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="1040" height="120" as="geometry" />
        </mxCell>

        <mxCell id="data_mongo" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🍃 MongoDB 7+&lt;/b&gt;&lt;br&gt;• Organizations &amp;amp; API Keys&lt;br&gt;• Domains &amp;amp; DNS Records&lt;br&gt;• Templates &amp;amp; Suppressions&lt;br&gt;• Emails &amp;amp; Email Events (Audit)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;align=center;" vertex="1" parent="box_data">
          <mxGeometry x="120" y="38" width="260" height="72" as="geometry" />
        </mxCell>

        <mxCell id="data_redis" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;⚡ Redis &amp;amp; BullMQ Queues&lt;/b&gt;&lt;br&gt;• &lt;b&gt;email-send-queue&lt;/b&gt; (Envois prioritaires)&lt;br&gt;• &lt;b&gt;email-track-queue&lt;/b&gt; (Pixel &amp;amp; Clics)&lt;br&gt;• &lt;b&gt;webhook-dispatch-queue&lt;/b&gt; (Notifications HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;align=left;spacingLeft=15;" vertex="1" parent="box_data">
          <mxGeometry x="620" y="38" width="320" height="72" as="geometry" />
        </mxCell>

        <!-- ZONE 4 : WORKERS POOL -->
        <mxCell id="box_workers" value="&lt;b&gt;Pool de Workers d'Envoi &amp;amp; Rendu (BullMQ Processors)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;fontColor=#6B21A8;rounded=1;shadow=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="1040" height="120" as="geometry" />
        </mxCell>

        <mxCell id="w_template" value="&lt;b&gt;1. Moteur Handlebars&lt;/b&gt;&lt;br&gt;Compilation du template&lt;br&gt;Substitution des variables&lt;br&gt;Fallback HTML / Texte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_workers">
          <mxGeometry x="50" y="45" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="w_inject" value="&lt;b&gt;2. Injection de Tracking&lt;/b&gt;&lt;br&gt;Pixel invisible 1x1 GIF&lt;br&gt;Wrapping &amp;amp; Signature des URLs&lt;br&gt;Headers RFC (Message-ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_workers">
          <mxGeometry x="320" y="45" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="w_transport" value="&lt;b&gt;3. Adaptateur Transport&lt;/b&gt;&lt;br&gt;Mailpit (Local Dev / Test)&lt;br&gt;AWS SES (Production)&lt;br&gt;Relais SMTP Standard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_workers">
          <mxGeometry x="600" y="45" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="w_retry" value="&lt;b&gt;4. Retries &amp;amp; DLQ&lt;/b&gt;&lt;br&gt;3 tentatives backoff exp&lt;br&gt;Gestion Soft/Hard Bounces&lt;br&gt;Auto-Suppression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;fontColor=#1E293B;fontSize=11;" vertex="1" parent="box_workers">
          <mxGeometry x="850" y="45" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ZONE 5 : DESTINATIONS & TRACKING -->
        <mxCell id="box_ext" value="&lt;b&gt;Monde Extérieur &amp;amp; Notifications&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;rounded=1;shadow=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="1040" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ext_recipients" value="&lt;b&gt;Boîtes de Réception&lt;/b&gt;&lt;br&gt;Gmail, Outlook, Apple Mail&lt;br&gt;&lt;i&gt;Emails délivrés avec DKIM/SPF&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;" vertex="1" parent="box_ext">
          <mxGeometry x="50" y="40" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ext_tracking" value="&lt;b&gt;Serveur de Tracking (Pixel &amp;amp; Clics)&lt;/b&gt;&lt;br&gt;GET /v1/track/open (GIF 1x1)&lt;br&gt;GET /v1/track/click (302 Redirect)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;" vertex="1" parent="box_ext">
          <mxGeometry x="400" y="40" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ext_webhooks" value="&lt;b&gt;Serveurs Webhook Clients&lt;/b&gt;&lt;br&gt;POST https://client.com/webhooks&lt;br&gt;&lt;i&gt;Événements delivered, bounced, opened&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;" vertex="1" parent="box_ext">
          <mxGeometry x="740" y="40" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- LIENS ET CONNECTEURS -->
        <mxCell id="e1" value="Requête HTTP / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" edge="1" parent="1" source="box_clients" target="box_api">
