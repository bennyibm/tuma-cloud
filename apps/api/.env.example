# ==============================================================================
# TUMA API BACKEND (apps/api) - VARIABLES D'ENVIRONNEMENT
# ==============================================================================

# Port d'écoute du serveur HTTP NestJS
PORT=3001
NODE_ENV=development

# Connexion Base de Données MongoDB (Local ou MongoDB Atlas en Prod)
# Local : mongodb://localhost:27017/tuma_db
# Prod  : mongodb+srv://<user>:<password>@cluster.mongodb.net/tuma_prod?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/tuma_db
MONGODB_URI=mongodb://localhost:27017/tuma_db

# Connexion Redis pour BullMQ (Local ou Upstash Redis en Prod)
# Local : localhost:6379
# Prod  : votre-instance.upstash.io (avec REDIS_PASSWORD)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Transport SMTP Sortant (Mailpit en Dev, Relais SMTP / Postfix en Prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sécurité & Cryptographie
JWT_SECRET=super_secret_jwt_key_tuma_cluster_2026_dev_secure
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# URLs de tracking et de redirection
TRACKING_BASE_URL=http://localhost:3001/v1/track
DASHBOARD_URL=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:3002
API_BASE_URL=http://localhost:3001

# Authentification OAuth 2.0 (Google / Gmail & GitHub)
# Google Cloud Console: Redirect URI = http://localhost:3001/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# GitHub Developer Settings (OAuth Apps): Redirect URI = http://localhost:3001/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/github/callback
